# mock = in-memory data, no backend needed. real = talk to the BillBistro API.
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: pin a single outlet instead of resolving the first active one from GET /v1/outlets
# NEXT_PUBLIC_OUTLET_ID=
# The standalone KDS app's URL, opened by the "KDS" nav link (usually a different screen/device)
NEXT_PUBLIC_KDS_URL=http://localhost:3002
