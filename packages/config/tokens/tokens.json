{
  "$description": "BillBistro design tokens - single source of truth for Figma variables and the Tailwind theme. DTCG / Style-Dictionary compatible. Semantic tokens carry per-mode values (dark is the default mode).",
  "color": {
    "brand": {
      "50":  { "$type": "color", "$value": "#FAF2E0" },
      "100": { "$type": "color", "$value": "#F3E4C4" },
      "200": { "$type": "color", "$value": "#EAD5A0" },
      "300": { "$type": "color", "$value": "#E9CE94" },
      "400": { "$type": "color", "$value": "#D9B26A" },
      "500": { "$type": "color", "$value": "#CA9C4E", "$description": "Isara's Gold - primary brand" },
      "600": { "$type": "color", "$value": "#9D621E" },
      "700": { "$type": "color", "$value": "#7A4B18" },
      "800": { "$type": "color", "$value": "#56340F" },
      "900": { "$type": "color", "$value": "#34251A" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "50":  { "$type": "color", "$value": "#FBF6EC" },
      "100": { "$type": "color", "$value": "#F8EFE0" },
      "200": { "$type": "color", "$value": "#ECE0CC" },
      "300": { "$type": "color", "$value": "#D6C7A8" },
      "400": { "$type": "color", "$value": "#B3A085" },
      "500": { "$type": "color", "$value": "#8A7862" },
      "600": { "$type": "color", "$value": "#6B5A48" },
      "700": { "$type": "color", "$value": "#4A3B2E" },
      "800": { "$type": "color", "$value": "#34251A" },
      "850": { "$type": "color", "$value": "#241A12" },
      "900": { "$type": "color", "$value": "#180F09" },
      "950": { "$type": "color", "$value": "#0C0704" }
    },
    "success": { "400": { "$type": "color", "$value": "#3EA968" }, "500": { "$type": "color", "$value": "#1C8742" }, "600": { "$type": "color", "$value": "#146633" } },
    "warning": { "400": { "$type": "color", "$value": "#FBBF24" }, "500": { "$type": "color", "$value": "#F59E0B" }, "600": { "$type": "color", "$value": "#D97706" } },
    "danger":  { "400": { "$type": "color", "$value": "#D65C5C" }, "500": { "$type": "color", "$value": "#BE2323" }, "600": { "$type": "color", "$value": "#8F1A1A" } },
    "info":    { "400": { "$type": "color", "$value": "#60A5FA" }, "500": { "$type": "color", "$value": "#3B82F6" }, "600": { "$type": "color", "$value": "#2563EB" } },
    "chart": {
      "1": { "$type": "color", "$value": "#CA9C4E" },
      "2": { "$type": "color", "$value": "#38BDF8" },
      "3": { "$type": "color", "$value": "#A78BFA" },
      "4": { "$type": "color", "$value": "#34D399" },
      "5": { "$type": "color", "$value": "#FBBF24" },
      "6": { "$type": "color", "$value": "#F472B6" }
    }
  },
  "semantic": {
    "background":         { "$type": "color", "$value": { "dark": "{color.neutral.950}", "light": "{color.neutral.50}" } },
    "surface":            { "$type": "color", "$value": { "dark": "{color.neutral.900}", "light": "{color.neutral.0}" } },
    "surface-raised":     { "$type": "color", "$value": { "dark": "{color.neutral.850}", "light": "{color.neutral.0}" } },
    "surface-overlay":    { "$type": "color", "$value": { "dark": "{color.neutral.800}", "light": "{color.neutral.100}" } },
    "border":             { "$type": "color", "$value": { "dark": "{color.neutral.700}", "light": "{color.neutral.200}" } },
    "border-strong":      { "$type": "color", "$value": { "dark": "{color.neutral.600}", "light": "{color.neutral.300}" } },
    "text":               { "$type": "color", "$value": { "dark": "{color.neutral.50}",  "light": "{color.neutral.900}" } },
    "text-muted":         { "$type": "color", "$value": { "dark": "{color.neutral.400}", "light": "{color.neutral.500}" } },
    "text-subtle":        { "$type": "color", "$value": { "dark": "{color.neutral.500}", "light": "{color.neutral.400}" } },
    "primary":            { "$type": "color", "$value": { "dark": "{color.brand.500}",   "light": "{color.brand.600}" } },
    "primary-hover":      { "$type": "color", "$value": { "dark": "{color.brand.400}",   "light": "{color.brand.700}" } },
    "primary-foreground": { "$type": "color", "$value": { "dark": "{color.neutral.0}",   "light": "{color.neutral.0}" } },
    "primary-soft":       { "$type": "color", "$value": { "dark": "#CA9C4E26",           "light": "{color.brand.50}" } },
    "success":            { "$type": "color", "$value": { "dark": "{color.success.400}", "light": "{color.success.600}" } },
    "warning":            { "$type": "color", "$value": { "dark": "{color.warning.400}", "light": "{color.warning.600}" } },
    "danger":             { "$type": "color", "$value": { "dark": "{color.danger.400}",  "light": "{color.danger.600}" } },
    "info":               { "$type": "color", "$value": { "dark": "{color.info.400}",    "light": "{color.info.600}" } },
    "ring":               { "$type": "color", "$value": { "dark": "{color.brand.400}",   "light": "{color.brand.500}" } }
  },
  "font": {
    "family": {
      "sans":    { "$type": "fontFamily", "$value": ["Jost", "system-ui", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["Marcellus", "Georgia", "Times New Roman", "serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["Space Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs":  { "$type": "dimension", "$value": "12px" },
      "sm":  { "$type": "dimension", "$value": "14px" },
      "md":  { "$type": "dimension", "$value": "16px" },
      "lg":  { "$type": "dimension", "$value": "18px" },
      "xl":  { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "36px" },
      "5xl": { "$type": "dimension", "$value": "48px" },
      "kds": { "$type": "dimension", "$value": "28px", "$description": "Glanceable kitchen display size" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "lineHeight": {
      "tight":  { "$type": "number", "$value": 1.15 },
      "snug":   { "$type": "number", "$value": 1.3 },
      "normal": { "$type": "number", "$value": 1.5 }
    }
  },
  "space": {
    "0":  { "$type": "dimension", "$value": "0px" },
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "touch": { "$type": "dimension", "$value": "56px", "$description": "Minimum POS touch target" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "14px" },
    "xl":   { "$type": "dimension", "$value": "20px" },
    "2xl":  { "$type": "dimension", "$value": "28px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "elevation": {
    "1":    { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.35)" },
    "2":    { "$type": "shadow", "$value": "0 4px 12px -2px rgb(0 0 0 / 0.45)" },
    "3":    { "$type": "shadow", "$value": "0 12px 32px -6px rgb(0 0 0 / 0.55)" },
    "glow": { "$type": "shadow", "$value": "0 0 0 1px rgb(202 156 78 / 0.4), 0 8px 24px -4px rgb(202 156 78 / 0.35)" }
  },
  "motion": {
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast":    { "$type": "duration", "$value": "150ms" },
      "base":    { "$type": "duration", "$value": "220ms" },
      "slow":    { "$type": "duration", "$value": "400ms" }
    },
    "easing": {
      "standard":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "emphasized": { "$type": "cubicBezier", "$value": [0.3, 0, 0, 1] },
      "spring":     { "$type": "string", "$value": "stiffness 420 / damping 32" }
    }
  }
}
